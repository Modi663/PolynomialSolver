QWidget {
    color: #1c2536;
    font-family: "Segoe UI";
    font-size: 10pt;
}

QMainWindow, QMainWindow > QWidget {
    background: #f5f7fb;
}

QLabel#pageTitle {
    font-size: 21pt;
    font-weight: 700;
    margin-bottom: 5px;
}

QFrame[card="true"] {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
}

QLabel[sectionTitle="true"] {
    font-size: 11pt;
    font-weight: 600;
}

QLabel[error="true"] {
    color: #b91c1c;
    min-height: 18px;
}

QLineEdit {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 6px 8px;
    selection-background-color: #bfdbfe;
}

QLineEdit:focus {
    border: 2px solid #2563eb;
    padding: 5px 7px;
}

QLineEdit[invalid="true"] {
    border: 2px solid #dc2626;
    background: #fef2f2;
    padding: 5px 7px;
}

QLineEdit:read-only {
    background: #f5f7fb;
    color: #475569;
}

QPushButton {
    background: #eef2f9;
    color: #2f3d54;
    border: 0;
    border-radius: 6px;
    padding: 7px 14px;
}

QPushButton:hover {
    background: #dbe5f4;
}

QPushButton:checked, QPushButton[primary="true"] {
    background: #2563eb;
    color: #ffffff;
}

QPushButton:checked:hover, QPushButton[primary="true"]:hover {
    background: #1d4ed8;
}

QPushButton:disabled {
    background: #e2e8f0;
    color: #94a3b8;
}

QPlainTextEdit {
    background: #ffffff;
    border: 0;
    color: #1e293b;
    font-family: "Consolas";
    font-size: 10.5pt;
}

QSplitter::handle {
    background: transparent;
    width: 12px;
}
